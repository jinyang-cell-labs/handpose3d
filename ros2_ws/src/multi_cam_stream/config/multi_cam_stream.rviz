Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /camera0
        - /camera1
        - /camera2
      Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: camera0
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera0/image_raw
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: camera1
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera1/image_raw
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: camera2
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera2/image_raw
      Value: true
  Global Options:
    Fixed Frame: map
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Value: true
Window Geometry:
  Displays:
    collapsed: false
  Height: 800
  Width: 1400
  camera0:
    collapsed: false
  camera1:
    collapsed: false
  camera2:
    collapsed: false
