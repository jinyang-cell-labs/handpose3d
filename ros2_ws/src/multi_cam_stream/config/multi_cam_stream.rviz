Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /cam0
        - /cam1
        - /cam2
      Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: cam0
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /cam0/image_raw
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: cam1
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /cam1/image_raw
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: cam2
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /cam2/image_raw
      Value: true
  Global Options:
    Fixed Frame: map
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Value: true
Window Geometry:
  Displays:
    collapsed: false
  Height: 800
  Width: 1400
  cam0:
    collapsed: false
  cam1:
    collapsed: false
  cam2:
    collapsed: false
