<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>body_cam_teleop</name>
  <version>0.1.0</version>
  <description>
    Chest-mounted (body) camera hand-pose teleoperation pipeline, forked from
    hand_teleop: MediaPipe hand landmarks (Python capture+detect node) ->
    Ceres monocular PnP + operator_body transform + TeleopMessage (C++ node).
    Explores body-mounted cameras instead of head-mounted ones.
  </description>
  <maintainer email="jinyang@cell-labs.ai">jinyang</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>ament_index_cpp</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>cv_bridge</depend>
  <depend>handpose3d_msgs</depend>
  <depend>robot_interfaces</depend>
  <depend>libopencv-dev</depend>
  <depend>eigen</depend>
  <depend>libceres-dev</depend>
  <depend>yaml-cpp</depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <!-- mediapipe is a pip dependency (no rosdep key): pip install mediapipe -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
